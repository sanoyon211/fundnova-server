# Application Server Config
PORT=5000
NODE_ENV=production
CLIENT_URL=https://fundnova.vercel.app

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fundnova?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudinary Cloud Storage (for ephemeral cloud hosting like Render/Railway)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (SMTP / Nodemailer / Resend / SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key
EMAIL_FROM="FundNova Platform" <notifications@fundnova.io>
